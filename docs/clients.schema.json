{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polarion MCP client setups",
  "type": "object",
  "required": [
    "checked",
    "server",
    "groups",
    "setups",
    "clients",
    "readmeGroups",
    "serverModes"
  ],
  "additionalProperties": false,
  "properties": {
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "server": {
      "type": "object",
      "required": [
        "remoteUrl",
        "stdioCommand",
        "stdioEnvironment"
      ],
      "additionalProperties": false,
      "properties": {
        "remoteUrl": {
          "type": "string",
          "minLength": 1
        },
        "stdioCommand": {
          "type": "string",
          "minLength": 1
        },
        "stdioEnvironment": {
          "type": "object",
          "required": [
            "API_BASE_URL",
            "BEARER_TOKEN"
          ],
          "additionalProperties": false,
          "properties": {
            "API_BASE_URL": {
              "type": "string",
              "minLength": 1
            },
            "BEARER_TOKEN": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "minItems": 1
    },
    "setups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setup"
      },
      "minItems": 1
    },
    "clients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/client"
      },
      "minItems": 1
    },
    "readmeGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "summary",
          "client"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "client": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "serverModes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "how"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "how": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "q",
          "a"
        ],
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "faqMore": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "q",
          "a"
        ],
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "id",
        "title",
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "mark",
              "description",
              "clients"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mark": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "clients": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "setup": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "language",
        "snippet",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "json",
            "bash",
            "text",
            "python"
          ]
        },
        "snippet": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "client": {
      "type": "object",
      "required": [
        "id",
        "name",
        "label",
        "provider",
        "setup",
        "steps",
        "sources",
        "checked",
        "note",
        "redirectUris",
        "connections",
        "defaultMode"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 6
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          },
          "minItems": 1
        },
        "checked": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "redirectUris": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "verified"
            ],
            "additionalProperties": false,
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "verified": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "snippet": {
          "type": "string",
          "minLength": 1
        },
        "referenceNote": {
          "type": "string"
        },
        "defaultMode": {
          "enum": [
            "npm",
            "docker",
            "remote"
          ]
        },
        "connections": {
          "type": "object",
          "required": [
            "npm",
            "docker",
            "remote"
          ],
          "additionalProperties": false,
          "properties": {
            "npm": {
              "$ref": "#/$defs/connection"
            },
            "docker": {
              "$ref": "#/$defs/connection"
            },
            "remote": {
              "$ref": "#/$defs/connection"
            }
          }
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "connection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "setup",
            "steps"
          ],
          "additionalProperties": false,
          "properties": {
            "setup": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 20
            },
            "snippet": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string"
            },
            "serverSetup": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "needs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verify": {
              "type": "object",
              "required": [
                "prompt",
                "expect"
              ],
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "expect": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "fails": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "symptom",
                  "fix"
                ],
                "additionalProperties": false,
                "properties": {
                  "symptom": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fix": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "teamNote": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
