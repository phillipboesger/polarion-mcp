{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polarion-mcp.example/schemas/clients.schema.json",
  "title": "Polarion MCP client compatibility matrix",
  "type": "object",
  "required": ["verified", "server", "clients", "redirectPresets"],
  "additionalProperties": false,
  "properties": {
    "verified": { "type": "string", "format": "date" },
    "server": {
      "type": "object", "required": ["remoteUrl", "stdioCommand", "stdioEnvironment"], "additionalProperties": false,
      "properties": { "remoteUrl": {"const":"https://YOUR-SERVER/mcp"}, "stdioCommand": {"const":"npx -y polarion-mcp"}, "stdioEnvironment": {"type":"object","required":["API_BASE_URL","BEARER_TOKEN"],"additionalProperties":{"type":"string"}} }
    },
    "clients": {
      "type":"array", "minItems":16,
      "items": {"type":"object","required":["id","name","transports","authModes","redirectUris","config","toolCountLimit","quirks","sources","verified","confidence"],"additionalProperties":false,
        "properties": {
          "id":{"type":"string"},"name":{"type":"string"},"transports":{"type":"array","items":{"enum":["stdio","streamable-http","sse"]}},
          "authModes":{"type":"array","items":{"enum":["static-header","oauth-dcr","cimd","preregistered-client","none"]}},
          "redirectUris":{"type":"array","items":{"type":"object","required":["uri","verified"],"additionalProperties":false,"properties":{"uri":{"type":"string"},"verified":{"type":"boolean"},"notes":{"type":"string"}}}},
          "config":{"type":"object","required":["transport","snippet"],"additionalProperties":false,"properties":{"transport":{"enum":["stdio","streamable-http","sse","rest-action"]},"snippet":{"type":"string"}}},
          "toolCountLimit":{"type":["integer","null"],"minimum":1},"quirks":{"type":"array","items":{"type":"string"}},"sources":{"type":"array","minItems":1,"items":{"type":"string","format":"uri"}},"verified":{"type":"string","format":"date"},"confidence":{"enum":["verified","unverified"]}
        }
      }
    },
    "redirectPresets":{"type":"array","items":{"type":"object","required":["name","patterns","sources","confidence"],"additionalProperties":false,"properties":{"name":{"enum":["claude","chatgpt","vscode","cursor","copilot-studio","gemini","loopback"]},"patterns":{"type":"array","items":{"type":"string"}},"sources":{"type":"array","items":{"type":"string","format":"uri"}},"confidence":{"enum":["verified","unverified"]},"notes":{"type":"string"}}}}
  }
}
