{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polarion MCP client setups",
  "type": "object",
  "required": [
    "checked",
    "server",
    "groups",
    "setups",
    "clients",
    "serverModes",
    "map"
  ],
  "additionalProperties": false,
  "properties": {
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "githubStars": {
      "type": "integer",
      "minimum": 0
    },
    "server": {
      "type": "object",
      "required": [
        "remoteUrl",
        "stdioCommand",
        "stdioEnvironment"
      ],
      "additionalProperties": false,
      "properties": {
        "remoteUrl": {
          "type": "string",
          "minLength": 1
        },
        "stdioCommand": {
          "type": "string",
          "minLength": 1
        },
        "stdioEnvironment": {
          "type": "object",
          "required": [
            "API_BASE_URL",
            "BEARER_TOKEN"
          ],
          "additionalProperties": false,
          "properties": {
            "API_BASE_URL": {
              "type": "string",
              "minLength": 1
            },
            "BEARER_TOKEN": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "minItems": 1
    },
    "setups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setup"
      },
      "minItems": 1
    },
    "clients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/client"
      },
      "minItems": 1
    },
    "serverModes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "local",
              "server"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "q",
          "a"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "q": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "faqMore": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "q",
          "a"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "q": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "map": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "logo",
          "color",
          "angle",
          "clients"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "logo": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "angle": {
            "type": "integer"
          },
          "clients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "id",
        "title",
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "mark",
              "description",
              "clients"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mark": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "clients": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "setup": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "language",
        "snippet",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "json",
            "bash",
            "text",
            "python"
          ]
        },
        "snippet": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "client": {
      "type": "object",
      "required": [
        "id",
        "name",
        "label",
        "provider",
        "sources",
        "checked",
        "note",
        "redirectUris",
        "defaultMode",
        "summary",
        "local",
        "server",
        "icon"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          },
          "minItems": 1
        },
        "checked": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "redirectUris": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "verified"
            ],
            "additionalProperties": false,
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "verified": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "referenceNote": {
          "type": "string"
        },
        "defaultMode": {
          "enum": [
            "local",
            "server"
          ]
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "local": {
          "$ref": "#/$defs/connection"
        },
        "server": {
          "$ref": "#/$defs/connection"
        },
        "icon": {
          "type": "string",
          "enum": [
            "desktop",
            "globe",
            "terminal",
            "api",
            "chat",
            "sliders",
            "box",
            "bot",
            "code",
            "building",
            "cursor",
            "sail",
            "ide",
            "server",
            "plug",
            "swap",
            "nodes"
          ]
        },
        "legacyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Former client ids; the generator writes a redirect stub guide for each."
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "description": "IDE variants that share one snippet and differ only in how the config is opened.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "minVersion",
              "openSteps"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "minVersion": {
                "type": "string",
                "minLength": 1
              },
              "openSteps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "connection": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "setup",
            "steps"
          ],
          "additionalProperties": false,
          "properties": {
            "setup": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 20
            },
            "snippet": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string"
            },
            "serverSetup": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "needs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verify": {
              "type": "object",
              "required": [
                "prompt",
                "expect"
              ],
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "expect": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "fails": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "symptom",
                  "fix"
                ],
                "additionalProperties": false,
                "properties": {
                  "symptom": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fix": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "teamNote": {
              "type": "string"
            },
            "alternative": {
              "type": "object",
              "required": [
                "title",
                "steps",
                "snippet"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "needs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "steps": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "snippet": {
                  "type": "string",
                  "minLength": 1
                },
                "language": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    }
  }
}
