# MCP Server Environment Variables
# Copy this file to .env and fill in the values

# Polarion API Configuration
# The base URL for your Polarion REST API endpoint (required)
# Example: https://your-polarion-server/polarion/rest/v1
API_BASE_URL=https://your-polarion-instance.com/polarion/rest/v1

# Authentication
# Bearer token for Polarion API authentication
# Get this from your Polarion user settings -> Personal Access Tokens
BEARER_TOKEN=your_polarion_bearer_token_here

# HTTP Server Configuration (only needed for HTTP mode / Custom GPT)
# Port for the HTTP REST API server
# Default: 3000
HTTP_PORT=3000

# HTTP Server Authentication
# API Key for authenticating requests to the HTTP server
# This protects your HTTP endpoints from unauthorized access
# Generate a secure random key: openssl rand -hex 32
# Custom GPT will use this key with "Authorization: Bearer YOUR_API_KEY"
HTTP_API_KEY=your_secure_api_key_here

# Streamable HTTP MCP transport (npm run start:mcp-http) — the network-facing
# target for remote MCP clients such as Claude.ai custom connectors. It holds
# no credentials: every /mcp request must send the caller's own Polarion
# Personal Access Token as "Authorization: Bearer <pat>".
# Optional: public HTTPS base URL of this deployment. Setting it enables the
# OAuth login flow, for clients (e.g. Claude.ai) that cannot be handed a token
# by hand.
# MCP_PUBLIC_URL=https://mcp.example.com
# Optional: bind address for the MCP HTTP server (default 0.0.0.0). Set to
# 127.0.0.1 when a TLS reverse proxy sits in front, so the plaintext port that
# carries client PATs is not reachable from outside.
# MCP_HTTP_HOST=127.0.0.1
# Optional: port for the MCP HTTP server (falls back to HTTP_PORT, then 3000)
# MCP_HTTP_PORT=3000
# Optional: comma-separated Host allow-list; setting it enables DNS-rebinding
# protection (recommended for public deployments), e.g. mcp.example.com
# MCP_ALLOWED_HOSTS=

# Optional: Logging
LOG_LEVEL=info

# Optional: TLS
# Use only for trusted internal servers with self-signed certificates
NODE_TLS_REJECT_UNAUTHORIZED=0
