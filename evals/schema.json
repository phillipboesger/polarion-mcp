{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 15,
  "maxItems": 15,
  "items": {
    "type": "object",
    "required": ["id", "task", "expectedTools", "readOnly"],
    "properties": {
      "id": { "type": "string", "pattern": "^P1-[0-9]{2}$" },
      "task": { "type": "string", "minLength": 10 },
      "expectedTools": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "readOnly": { "type": "boolean" }
    },
    "additionalProperties": false
  }
}
